<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CyberPuls - Blitz Tracker</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            user-select: none;
        }

        body {
            background-color: #070b19;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            position: relative;
        }

        body::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 20%, rgba(0, 242, 254, 0.08) 0%, transparent 60%),
                        radial-gradient(circle at 80% 80%, rgba(79, 70, 229, 0.08) 0%, transparent 50%);
            z-index: -1;
        }

        .header {
            padding: 16px 20px 8px 20px;
            display: flex;
            justify-content: center;
            width: 100%;
        }

        .user-card {
            background: linear-gradient(135deg, rgba(16, 24, 48, 0.8) 0%, rgba(26, 38, 74, 0.8) 100%);
            border: 1px solid rgba(0, 242, 254, 0.2);
            border-radius: 16px;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(8px);
        }

        .username {
            font-weight: 700;
            font-size: 15px;
            letter-spacing: 1px;
            color: #e2e8f0;
        }

        .balance-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(0, 242, 254, 0.1);
            border: 1px solid rgba(0, 242, 254, 0.3);
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 14px;
            color: #00f2fe;
        }

        .profile-icon {
            width: 32px;
            height: 32px;
            background: rgba(0, 242, 254, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #00f2fe;
            border: 1px solid rgba(0, 242, 254, 0.3);
        }

        .info-strip {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
            padding: 0 24px;
            font-size: 12px;
            color: #94a3b8;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .info-value {
            color: #fff;
            font-weight: 600;
        }

        .progress-bar-container {
            width: 100%;
            max-width: 400px;
            margin: 6px auto 0 auto;
            padding: 0 24px;
        }

        .progress-bar-bg {
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #00f2fe, #4f46e5);
            width: 5%;
            transition: width 0.5s ease;
        }

        /* Контейнеры экранов */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            padding-bottom: 30px;
            overflow-y: auto;
        }

        .view-section {
            display: none;
            width: 100%;
            height: 100%;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
        }

        .view-section.active {
            display: flex;
        }

        .placeholder-card {
            background: rgba(16, 24, 48, 0.6);
            border: 1px solid rgba(0, 242, 254, 0.2);
            border-radius: 16px;
            padding: 30px 20px;
            max-width: 320px;
            width: 100%;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .placeholder-title {
            font-size: 16px;
            font-weight: 700;
            color: #00f2fe;
            margin-bottom: 8px;
        }

        .placeholder-text {
            font-size: 13px;
            color: #94a3b8;
            line-height: 1.4;
        }

        /* Элементы колеса */
        .reward-info {
            text-align: center;
            margin-bottom: 15px;
        }

        .reward-title {
            color: #00f2fe;
            font-weight: 600;
            font-size: 15px;
            text-shadow: 0 0 10px rgba(0, 242, 254, 0.4);
            margin-bottom: 2px;
        }

        .reward-timer {
            font-size: 12px;
            color: #94a3b8;
        }

        .wheel-container {
            position: relative;
            width: 280px;
            height: 280px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .wheel-pointer {
            position: absolute;
            top: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-bottom: 14px solid #00f2fe;
            z-index: 10;
            filter: drop-shadow(0 0 6px #00f2fe);
        }

        .wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 3px solid rgba(0, 242, 254, 0.4);
            position: relative;
            box-shadow: 0 0 30px rgba(0, 242, 254, 0.15), inset 0 0 30px rgba(0, 242, 254, 0.15);
            background: radial-gradient(circle, rgba(16, 24, 48, 0.9) 0%, rgba(7, 11, 25, 0.95) 100%);
            transition: transform 4s cubic-bezier(0.15, 0.85, 0.15, 1);
        }

        .wheel-sector {
            position: absolute;
            width: 100%;
            height: 100%;
            text-align: center;
            font-weight: 700;
            font-size: 15px;
            color: #00f2fe;
            padding-top: 18px;
        }

        .s1 { transform: rotate(0deg); }
        .s2 { transform: rotate(90deg); }
        .s3 { transform: rotate(180deg); }
        .s4 { transform: rotate(270deg); }

        .spin-hint {
            margin-top: 15px;
            font-size: 13px;
            color: #64748b;
            letter-spacing: 0.5px;
            animation: pulse-text 2s infinite;
        }

        @keyframes pulse-text {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .spin-btn {
            position: absolute;
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, #00f2fe 0%, #4f46e5 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            color: #fff;
            letter-spacing: 1px;
            cursor: pointer;
            border: 3px solid #070b19;
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.5);
            transition: transform 0.1s ease, filter 0.2s ease;
            z-index: 5;
        }

        .spin-btn:active {
            transform: scale(0.95);
        }

        .spin-btn:disabled {
            background: #1e293b;
            color: #64748b;
            border-color: #334155;
            box-shadow: none;
            cursor: not-allowed;
        }

        .win-notification {
            position: absolute;
            top: 10%;
            font-weight: 700;
            font-size: 18px;
            color: #00f2fe;
            text-shadow: 0 0 15px rgba(0, 242, 254, 0.8);
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.4s ease;
            pointer-events: none;
        }

        .win-notification.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* Нижняя навигация */
        .nav-bar {
            background: rgba(10, 15, 35, 0.9);
            border-top: 1px solid rgba(0, 242, 254, 0.15);
            padding: 10px 20px 20px 20px;
            display: flex;
            justify-content: space-around;
            backdrop-filter: blur(10px);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            background: none;
            border: none;
            color: #64748b;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .nav-item.active {
            color: #00f2fe;
        }

        .nav-icon {
            font-size: 18px;
        }
    </style>
</head>
<body>

    <header class="header">
        <div class="user-card">
            <div class="username">CYBERPULS</div>
            <div class="balance-badge">
                <span>⚡</span>
                <span id="lp-counter">0 LP</span>
            </div>
            <div class="profile-icon">👤</div>
        </div>
    </header>

    <div class="info-strip">
        <div class="info-item">
            <span>🔥 Серия:</span>
            <span class="info-value" id="streak-text">1 день</span>
        </div>
        <div class="info-item">
            <span>🏆 Ранг:</span>
            <span class="info-value" id="rank-text">Новичок</span>
        </div>
    </div>
    <div class="progress-bar-container">
        <div class="progress-bar-bg">
            <div class="progress-bar-fill" id="progress-fill"></div>
        </div>
    </div>

    <!-- Основной контент (Экраны) -->
    <main class="main-content">
        <!-- Экран 1: Арена (Колесо) -->
        <div class="view-section active" id="view-arena">
            <div class="win-notification" id="win-notification">+0 LP!</div>

            <div class="reward-info">
                <div class="reward-title" id="reward-status-title">Ежедневная награда!</div>
                <div class="reward-timer" id="reward-timer-text">Доступно сейчас</div>
            </div>

            <div class="wheel-container">
                <div class="wheel-pointer"></div>
                <div class="wheel" id="wheel">
                    <div class="wheel-sector s1">100</div>
                    <div class="wheel-sector s2">25</div>
                    <div class="wheel-sector s3">50</div>
                    <div class="wheel-sector s4">10</div>
                </div>
                <button class="spin-btn" id="spin-btn" onclick="spinWheel()">SPIN</button>
            </div>

            <div class="spin-hint" id="spin-hint-text">Нажми, чтобы испытать удачу</div>
        </div>

        <!-- Экран 2: Сессии -->
        <div class="view-section" id="view-sessions">
            <div class="placeholder-card">
                <div class="placeholder-title">История сессий</div>
                <div class="placeholder-text">Здесь будет отображаться лог твоей активности и прошлых начислений LP.</div>
            </div>
        </div>

        <!-- Экран 3: Турниры -->
        <div class="view-section" id="view-tournaments">
            <div class="placeholder-card">
                <div class="placeholder-title">Активные турниры</div>
                <div class="placeholder-text">Следи за анонсами в канале. Скоро здесь появятся киберспортивные ивенты!</div>
            </div>
        </div>

        <!-- Экран 4: Лидеры -->
        <div class="view-section" id="view-leaders">
            <div class="placeholder-card">
                <div class="placeholder-title">Таблица лидеров</div>
                <div class="placeholder-text">Рейтинг лучших участников комьюнити по количеству набранных LP.</div>
            </div>
        </div>
    </main>

    <!-- Нижняя навигация -->
    <nav class="nav-bar">
        <button class="nav-item active" onclick="switchTab('arena', this)">
            <span class="nav-icon">⚡</span>
            <span>Арена</span>
        </button>
        <button class="nav-item" onclick="switchTab('sessions', this)">
            <span class="nav-icon">📊</span>
            <span>Сессии</span>
        </button>
        <button class="nav-item" onclick="switchTab('tournaments', this)">
            <span class="nav-icon">🏆</span>
            <span>Турниры</span>
        </button>
        <button class="nav-item" onclick="switchTab('leaders', this)">
            <span class="nav-icon">👑</span>
            <span>Лидеры</span>
        </button>
    </nav>

    <script>
        let savedLP = localStorage.getItem('cyber_lp');
        let userLP = savedLP !== null ? parseInt(savedLP) : 0;
        let streak = parseInt(localStorage.getItem('cyber_streak')) || 1;
        let lastSpinDate = localStorage.getItem('cyber_last_spin') || '';

        const rewards = [100, 25, 50, 10];
        const angles = [0, 90, 180, 270];
        let currentRotation = 0;
        let isSpinning = false;

        const lpCounter = document.getElementById('lp-counter');
        const spinBtn = document.getElementById('spin-btn');
        const wheel = document.getElementById('wheel');
        const winNotification = document.getElementById('win-notification');
        const streakText = document.getElementById('streak-text');
        const rankText = document.getElementById('rank-text');
        const progressFill = document.getElementById('progress-fill');
        const rewardTimerText = document.getElementById('reward-timer-text');
        const rewardStatusTitle = document.getElementById('reward-status-title');
        const spinHintText = document.getElementById('spin-hint-text');

        // Функция переключения вкладок
        function switchTab(tabId, btnElement) {
            // Скрываем все экраны
            document.querySelectorAll('.view-section').forEach(section => {
                section.classList.remove('active');
            });
            // Показываем нужный
            document.getElementById('view-' + tabId).classList.add('active');

            // Убираем подсветку со всех кнопок меню
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });
            // Подсвечиваем нажатую кнопку
            btnElement.classList.add('active');
        }

        function updateUI() {
            lpCounter.textContent = userLP.toLocaleString() + ' LP';
            streakText.textContent = streak + ' дн.';

            let rankName = "Новичок";
            let progressPercent = (userLP % 500) / 5;

            if (userLP >= 2000) {
                rankName = "Элита";
                progressPercent = 100;
            } else if (userLP >= 1000) {
                rankName = "Хакер";
            } else if (userLP >= 500) {
                rankName = "Стритрейсер";
            }

            rankText.textContent = rankName;
            progressFill.style.width = Math.min(Math.max(progressPercent, 5), 100) + '%';
        }

        function checkCooldown() {
            if (!lastSpinDate) return;

            const lastDate = new Date(lastSpinDate);
            const now = new Date();
            const diffHours = (now - lastDate) / (1000 * 60 * 60);

            if (diffHours < 24) {
                spinBtn.disabled = true;
                const hoursLeft = Math.ceil(24 - diffHours);
                rewardStatusTitle.textContent = "Награда получена";
                rewardTimerText.textContent = `Следующая через ~${hoursLeft}ч`;
                spinHintText.textContent = "Колесо заблокировано до завтра";
            } else {
                spinBtn.disabled = false;
                rewardStatusTitle.textContent = "Ежедневная награда!";
                rewardTimerText.textContent = "Доступно сейчас";
                spinHintText.textContent = "Нажми, чтобы испытать удачу";
            }
        }

        function spinWheel() {
            if (isSpinning) return;
            isSpinning = true;
            spinBtn.disabled = true;

            const randomIndex = Math.floor(Math.random() * rewards.length);
            const selectedReward = rewards[randomIndex];
            
            const extraSpins = 360 * (5 + Math.floor(Math.random() * 3));
            const targetAngle = extraSpins + (360 - angles[randomIndex]);

            currentRotation += targetAngle;
            wheel.style.transform = `rotate(${currentRotation}deg)`;

            setTimeout(() => {
                userLP += selectedReward;
                
                const today = new Date().toDateString();
                if (lastSpinDate) {
                    const lastD = new Date(lastSpinDate);
                    const diffDays = Math.floor((new Date() - lastD) / (1000 * 60 * 60 * 24));
                    if (diffDays === 1) {
                        streak++;
                    } else if (diffDays > 1) {
                        streak = 1;
                    }
                }
                
                lastSpinDate = new Date().toISOString();
                localStorage.setItem('cyber_lp', userLP);
                localStorage.setItem('cyber_streak', streak);
                localStorage.setItem('cyber_last_spin', lastSpinDate);

                updateUI();

                winNotification.textContent = `+${selectedReward} LP!`;
                winNotification.classList.add('show');

                setTimeout(() => {
                    winNotification.classList.remove('show');
                    checkCooldown();
                    isSpinning = false;
                }, 2000);

            }, 4000);
        }

        updateUI();
        checkCooldown();
    </script>
</body>
</html>
